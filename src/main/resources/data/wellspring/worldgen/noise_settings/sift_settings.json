{
  "default_block": {
    "Name": "wellspring:sift_stone"
  },
  "default_fluid": {
    "Name": "minecraft:air"
  },
  "sea_level": -64,
  "disable_mob_generation": false,
  "aquifers_enabled": false,
  "ore_veins_enabled": false,
  "legacy_random_source": false,
  "noise": {
    "min_y": -64,
    "height": 384,
    "size_horizontal": 1,
    "size_vertical": 2
  },
  "noise_router": {
    "barrier": 0,
    "fluid_level_floodedness": 0,
    "fluid_level_spread": 0,
    "lava": 0,
    "vein_toggle": 0,
    "vein_ridged": 0,
    "vein_gap": 0,
    "temperature": "wellspring:sift/terrain_selector",
    "vegetation": {
      "type": "minecraft:flat_cache",
      "argument": {
        "type": "minecraft:noise",
        "noise": "wellspring:forest_detail",
        "xz_scale": 0.018,
        "y_scale": 0
      }
    },
    "continents": 0,
    "erosion": 0,
    "depth": 0,
    "ridges": 0,
    "preliminary_surface_level": {
      "type": "minecraft:find_top_surface",
      "density": "wellspring:sift/terrain/surface",
      "upper_bound": 128,
      "lower_bound": -64,
      "cell_height": 8
    },
    "final_density": {
      "type": "minecraft:range_choice",
      "input": "minecraft:y",
      "min_inclusive": -64,
      "max_exclusive": 128,
      "when_in_range": {
        "type": "minecraft:interpolated",
        "argument": "wellspring:sift/final_density"
      },
      "when_out_of_range": -1
    }
  },
  "spawn_target": [],
  "surface_rule": {
    "type": "minecraft:sequence",
    "sequence": [
      {
        "type": "minecraft:condition",
        "if_true": {
          "type": "minecraft:vertical_gradient",
          "false_at_and_above": {
            "above_bottom": 5
          },
          "random_name": "minecraft:bedrock_floor",
          "true_at_and_below": {
            "above_bottom": 0
          }
        },
        "then_run": {
          "type": "minecraft:block",
          "result_state": {
            "Name": "minecraft:bedrock"
          }
        }
      },
      {
        "type": "minecraft:condition",
        "if_true": {
          "type": "minecraft:vertical_gradient",
          "false_at_and_above": {
            "absolute": 8
          },
          "random_name": "wellspring:hardened_sift_stone",
          "true_at_and_below": {
            "absolute": 0
          }
        },
        "then_run": {
          "type": "minecraft:block",
          "result_state": {
            "Name": "wellspring:hardened_sift_stone",
            "Properties": {
              "axis": "y"
            }
          }
        }
      },
      {
        "type": "minecraft:condition",
        "if_true": {
          "type": "minecraft:above_preliminary_surface"
        },
        "then_run": {
          "type": "minecraft:condition",
          "if_true": {
            "type": "minecraft:stone_depth",
            "add_surface_depth": false,
            "offset": 0,
            "secondary_depth_range": 0,
            "surface_type": "floor"
          },
          "then_run": {
            "type": "minecraft:block",
            "result_state": {
              "Name": "wellspring:sift_grass_block"
            }
          }
        }
      }
    ]
  }
}
